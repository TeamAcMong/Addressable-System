/*
 * Shell chrome for AddressableManagerHub.
 *
 * Layout and spacing only - every colour comes from --unity-colors-* so the window follows the
 * active Editor skin (design doc §5.11). USS has no CSS grid, no ::before/::after, no box-shadow,
 * no rem/em and no @media; nothing here needs them.
 *
 * The four state modifiers at the bottom are the load-bearing part of this sheet. They are the
 * only place a health state becomes a colour, so "not measured" cannot accidentally be painted
 * the same as "passed" by one screen that forgot - see SectionHealth.
 */

.hub-root {
    flex-grow: 1;
    background-color: var(--unity-colors-window-background);
}

/* ---------- header ---------- */

.hub-header {
    flex-direction: row;
    align-items: center;
    height: 26px;
    padding: 0 8px;
    flex-shrink: 0;
    background-color: var(--unity-colors-toolbar-background);
    border-bottom-width: 1px;
    border-bottom-color: var(--unity-colors-window-border);
}

.hub-header-title {
    font-size: 12px;
    -unity-font-style: bold;
    color: var(--unity-colors-default-text);
}

.hub-header-spacer {
    flex-grow: 1;
}

.hub-header-context {
    font-size: 11px;
    color: var(--unity-colors-default-text);
    opacity: 0.7;
}

/* ---------- body split ---------- */

.hub-body {
    flex-direction: row;
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
}

/* ---------- rail ---------- */

.hub-rail {
    width: 196px;
    flex-shrink: 0;
    flex-direction: column;
    background-color: var(--unity-colors-default-background);
    border-right-width: 1px;
    border-right-color: var(--unity-colors-window-border);
}

.hub-rail-caption {
    font-size: 9px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    padding: 9px 10px 3px 10px;
    color: var(--unity-colors-default-text);
    opacity: 0.5;
}

.hub-rail-scroll {
    flex-grow: 1;
}

.hub-rail-stages {
    flex-direction: column;
}

/* a stage heading: dot, label, badge */
.hub-stage {
    flex-direction: row;
    align-items: center;
    padding: 4px 10px 2px 10px;
    flex-shrink: 0;
}

.hub-stage-dot {
    width: 8px;
    height: 8px;
    border-radius: 4px;
    flex-shrink: 0;
    margin-right: 7px;
    border-width: 2px;
}

.hub-stage-label {
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    flex-grow: 1;
    color: var(--unity-colors-default-text);
    opacity: 0.8;
}

.hub-stage-badge {
    font-size: 9px;
    -unity-font-style: bold;
    flex-shrink: 0;
}

/* a section row under a stage */
.hub-section-row {
    flex-direction: row;
    align-items: center;
    padding: 3px 10px 3px 25px;
    flex-shrink: 0;
}

.hub-section-row:hover {
    background-color: var(--unity-colors-highlight-background-hover);
}

.hub-section-row--active {
    background-color: var(--unity-colors-highlight-background);
}

.hub-section-row-label {
    font-size: 11px;
    flex-grow: 1;
    color: var(--unity-colors-default-text);
}

.hub-section-row--active .hub-section-row-label {
    -unity-font-style: bold;
}

.hub-section-row-dot {
    width: 5px;
    height: 5px;
    border-radius: 3px;
    flex-shrink: 0;
    margin-left: 4px;
}

/* the "pipeline stops here" note pinned to the bottom of the rail */
.hub-rail-blocker {
    flex-shrink: 0;
    flex-direction: column;
    margin: 6px;
    padding: 6px 8px;
    border-width: 1px;
    border-radius: 3px;
    border-color: var(--unity-colors-window-border);
    background-color: var(--unity-colors-toolbar-background);
}

.hub-rail-blocker-title {
    font-size: 10px;
    -unity-font-style: bold;
    white-space: normal;
}

.hub-rail-blocker-body {
    font-size: 10px;
    margin-top: 2px;
    white-space: normal;
    color: var(--unity-colors-default-text);
    opacity: 0.75;
}

/* ---------- content ---------- */

.hub-content {
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: column;
    min-width: 0;
}

.hub-section-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    flex-shrink: 0;
    height: 36px;
    padding: 0 10px;
    background-color: var(--unity-colors-toolbar-background);
    border-bottom-width: 1px;
    border-bottom-color: var(--unity-colors-window-border);
}

.hub-section-titles {
    flex-direction: column;
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.hub-section-title {
    font-size: 12px;
    -unity-font-style: bold;
    color: var(--unity-colors-default-text);
}

.hub-section-subtitle {
    font-size: 10px;
    color: var(--unity-colors-default-text);
    opacity: 0.65;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.hub-section-actions {
    flex-direction: row;
    flex-shrink: 0;
}

.hub-section-body {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
}

/* ---------- status bar ---------- */

.hub-status {
    flex-direction: row;
    align-items: center;
    height: 20px;
    padding: 0 8px;
    flex-shrink: 0;
    background-color: var(--unity-colors-toolbar-background);
    border-top-width: 1px;
    border-top-color: var(--unity-colors-window-border);
}

.hub-status-dot {
    width: 6px;
    height: 6px;
    border-radius: 3px;
    flex-shrink: 0;
    margin-right: 7px;
}

.hub-status-text {
    font-size: 10px;
    flex-grow: 1;
    color: var(--unity-colors-default-text);
    opacity: 0.8;
}

.hub-status-context {
    font-size: 10px;
    flex-shrink: 0;
    color: var(--unity-colors-default-text);
    opacity: 0.55;
}

/*
 * ---------- the four states ----------
 *
 * Applied to dots, badges and text. Four, not three: "unmeasured" is hollow rather than filled,
 * so a check that did not run can never be mistaken for one that passed - which is exactly what
 * happened when the two shared a colour.
 */

.hub-state--ok {
    background-color: var(--unity-colors-default-text);
    border-color: var(--unity-colors-default-text);
    color: var(--unity-colors-default-text);
    opacity: 0.55;
}

.hub-state--warn {
    background-color: var(--unity-colors-warning-text);
    border-color: var(--unity-colors-warning-text);
    color: var(--unity-colors-warning-text);
}

.hub-state--blocked {
    background-color: var(--unity-colors-error-text);
    border-color: var(--unity-colors-error-text);
    color: var(--unity-colors-error-text);
}

/* hollow: a ring with the window behind it, never a filled dot */
.hub-state--unmeasured {
    background-color: rgba(0, 0, 0, 0);
    border-color: var(--unity-colors-default-text);
    color: var(--unity-colors-default-text);
    opacity: 0.4;
}
