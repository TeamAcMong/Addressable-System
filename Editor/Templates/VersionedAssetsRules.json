{
  "version": "1.0",
  "description": "Versioned assets rules - Automatically version assets for content updates",
  "autoApplyOnImport": false,
  "autoApplyOnModified": true,
  "verboseLogging": true,
  "versionExpression": "[1.0.0,2.0.0)",
  "excludeUnversioned": false,
  "addressRules": [
    {
      "ruleName": "Core Game Assets",
      "description": "Core assets that rarely change",
      "enabled": true,
      "priority": 100,
      "skipExisting": false,
      "targetGroupName": "CoreAssets",
      "filters": [
        {
          "filterType": "PathFilter",
          "filterAssetPath": "",
          "filterJson": "{\"_enabled\":true,\"_invert\":false,\"_description\":\"Everything under Assets - narrow this before enabling\",\"_pattern\":\"Assets/**\",\"_matchMode\":5,\"_caseSensitive\":false}"
        }
      ],
      "addressProviderType": "PathAddressProvider",
      "addressProviderPath": ""
    },
    {
      "ruleName": "DLC Content",
      "description": "Downloadable content assets",
      "enabled": true,
      "priority": 90,
      "skipExisting": false,
      "targetGroupName": "DLC",
      "filters": [
        {
          "filterType": "PathFilter",
          "filterAssetPath": "",
          "filterJson": "{\"_enabled\":true,\"_invert\":false,\"_description\":\"Anything under Assets/DLC\",\"_pattern\":\"Assets/DLC/**\",\"_matchMode\":5,\"_caseSensitive\":false}"
        }
      ],
      "addressProviderType": "PathAddressProvider",
      "addressProviderPath": ""
    }
  ],
  "labelRules": [
    {
      "ruleName": "Static Content Label",
      "description": "Mark static content for build-time inclusion",
      "enabled": true,
      "priority": 100,
      "appendToExisting": true,
      "filters": [
        {
          "filterType": "PathFilter",
          "filterAssetPath": "",
          "filterJson": "{\"_enabled\":true,\"_invert\":false,\"_description\":\"Anything under Assets/UI\",\"_pattern\":\"Assets/UI/**\",\"_matchMode\":5,\"_caseSensitive\":false}"
        }
      ],
      "labelProviderType": "ConstantLabelProvider",
      "labelProviderPath": "",
      "labelProviderJson": "{\"_description\":\"Mark static content for build-time inclusion\",\"_labels\":[\"content_static\"]}"
    },
    {
      "ruleName": "Dynamic Content Label",
      "description": "Mark dynamic content for remote updates",
      "enabled": true,
      "priority": 90,
      "appendToExisting": true,
      "filters": [
        {
          "filterType": "PathFilter",
          "filterAssetPath": "",
          "filterJson": "{\"_enabled\":true,\"_invert\":false,\"_description\":\"Everything under Assets - narrow this before enabling\",\"_pattern\":\"Assets/**\",\"_matchMode\":5,\"_caseSensitive\":false}"
        }
      ],
      "labelProviderType": "ConstantLabelProvider",
      "labelProviderPath": "",
      "labelProviderJson": "{\"_description\":\"Mark dynamic content for remote updates\",\"_labels\":[\"content_dynamic\"]}"
    }
  ],
  "versionRules": [
    {
      "ruleName": "Build Version",
      "description": "Apply build version to all assets",
      "enabled": true,
      "priority": 100,
      "skipExisting": false,
      "filters": [
        {
          "filterType": "PathFilter",
          "filterAssetPath": "",
          "filterJson": "{\"_enabled\":true,\"_invert\":false,\"_description\":\"Anything under Assets/UI\",\"_pattern\":\"Assets/UI/**\",\"_matchMode\":5,\"_caseSensitive\":false}"
        }
      ],
      "versionProviderType": "BuildNumberVersionProvider",
      "versionProviderPath": ""
    },
    {
      "ruleName": "Git Commit Version",
      "description": "Apply git commit hash for tracking",
      "enabled": false,
      "priority": 90,
      "skipExisting": false,
      "filters": [
        {
          "filterType": "PathFilter",
          "filterAssetPath": "",
          "filterJson": "{\"_enabled\":true,\"_invert\":false,\"_description\":\"Everything under Assets - narrow this before enabling\",\"_pattern\":\"Assets/**\",\"_matchMode\":5,\"_caseSensitive\":false}"
        }
      ],
      "versionProviderType": "GitCommitVersionProvider",
      "versionProviderPath": ""
    },
    {
      "ruleName": "Date Version",
      "description": "Apply timestamp version",
      "enabled": false,
      "priority": 80,
      "skipExisting": false,
      "filters": [
        {
          "filterType": "PathFilter",
          "filterAssetPath": "",
          "filterJson": "{\"_enabled\":true,\"_invert\":false,\"_description\":\"Everything under Assets - narrow this before enabling\",\"_pattern\":\"Assets/**\",\"_matchMode\":5,\"_caseSensitive\":false}"
        }
      ],
      "versionProviderType": "DateVersionProvider",
      "versionProviderPath": ""
    }
  ]
}
