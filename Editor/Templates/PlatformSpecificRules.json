{
  "version": "1.0",
  "description": "Platform-specific labeling rules - Adds platform labels for conditional loading",
  "autoApplyOnImport": false,
  "autoApplyOnModified": true,
  "verboseLogging": false,
  "versionExpression": "",
  "excludeUnversioned": false,
  "addressRules": [
    {
      "ruleName": "High Quality Assets",
      "description": "High resolution assets for PC/Console",
      "enabled": true,
      "priority": 100,
      "skipExisting": false,
      "targetGroupName": "HighQuality",
      "filters": [
        {
          "filterType": "PathFilter",
          "filterAssetPath": "",
          "filterJson": "{\"_enabled\":true,\"_invert\":false,\"_description\":\"Anything under a HighQuality folder\",\"_pattern\":\"Assets/**/HighQuality/**\",\"_matchMode\":5,\"_caseSensitive\":false}"
        }
      ],
      "addressProviderType": "PathAddressProvider",
      "addressProviderPath": ""
    },
    {
      "ruleName": "Mobile Optimized Assets",
      "description": "Optimized assets for mobile platforms",
      "enabled": true,
      "priority": 90,
      "skipExisting": false,
      "targetGroupName": "Mobile",
      "filters": [
        {
          "filterType": "PathFilter",
          "filterAssetPath": "",
          "filterJson": "{\"_enabled\":true,\"_invert\":false,\"_description\":\"Anything under a Mobile folder\",\"_pattern\":\"Assets/**/Mobile/**\",\"_matchMode\":5,\"_caseSensitive\":false}"
        }
      ],
      "addressProviderType": "PathAddressProvider",
      "addressProviderPath": ""
    }
  ],
  "labelRules": [
    {
      "ruleName": "PC Platform Label",
      "description": "Add 'pc' label to high quality assets",
      "enabled": true,
      "priority": 100,
      "appendToExisting": true,
      "filters": [
        {
          "filterType": "PathFilter",
          "filterAssetPath": "",
          "filterJson": "{\"_enabled\":true,\"_invert\":false,\"_description\":\"Anything under a HighQuality folder\",\"_pattern\":\"Assets/**/HighQuality/**\",\"_matchMode\":5,\"_caseSensitive\":false}"
        }
      ],
      "labelProviderType": "ConstantLabelProvider",
      "labelProviderPath": "",
      "labelProviderJson": "{\"_description\":\"Add 'pc' label to high quality assets\",\"_labels\":[\"platform_pc\"]}"
    },
    {
      "ruleName": "Mobile Platform Label",
      "description": "Add 'mobile' label to mobile-optimized assets",
      "enabled": true,
      "priority": 90,
      "appendToExisting": true,
      "filters": [
        {
          "filterType": "PathFilter",
          "filterAssetPath": "",
          "filterJson": "{\"_enabled\":true,\"_invert\":false,\"_description\":\"Anything under a Mobile folder\",\"_pattern\":\"Assets/**/Mobile/**\",\"_matchMode\":5,\"_caseSensitive\":false}"
        }
      ],
      "labelProviderType": "ConstantLabelProvider",
      "labelProviderPath": "",
      "labelProviderJson": "{\"_description\":\"Add 'mobile' label to mobile-optimized assets\",\"_labels\":[\"platform_mobile\"]}"
    },
    {
      "ruleName": "Android Platform",
      "description": "Add 'android' label",
      "enabled": true,
      "priority": 80,
      "appendToExisting": true,
      "filters": [
        {
          "filterType": "PathFilter",
          "filterAssetPath": "",
          "filterJson": "{\"_enabled\":true,\"_invert\":false,\"_description\":\"Everything under Assets - narrow this before enabling\",\"_pattern\":\"Assets/**\",\"_matchMode\":5,\"_caseSensitive\":false}"
        }
      ],
      "labelProviderType": "ConstantLabelProvider",
      "labelProviderPath": "",
      "labelProviderJson": "{\"_description\":\"Add 'android' label\",\"_labels\":[\"platform_android\"]}"
    },
    {
      "ruleName": "iOS Platform",
      "description": "Add 'ios' label",
      "enabled": true,
      "priority": 70,
      "appendToExisting": true,
      "filters": [
        {
          "filterType": "PathFilter",
          "filterAssetPath": "",
          "filterJson": "{\"_enabled\":true,\"_invert\":false,\"_description\":\"Everything under Assets - narrow this before enabling\",\"_pattern\":\"Assets/**\",\"_matchMode\":5,\"_caseSensitive\":false}"
        }
      ],
      "labelProviderType": "ConstantLabelProvider",
      "labelProviderPath": "",
      "labelProviderJson": "{\"_description\":\"Add 'ios' label\",\"_labels\":[\"platform_ios\"]}"
    }
  ],
  "versionRules": []
}
