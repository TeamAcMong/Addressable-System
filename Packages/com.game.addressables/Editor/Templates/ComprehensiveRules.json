{
  "version": "1.0",
  "description": "Comprehensive rule set - Demonstrates all rule types and features",
  "autoApplyOnImport": false,
  "autoApplyOnModified": true,
  "verboseLogging": false,
  "versionExpression": "[1.0.0,)",
  "excludeUnversioned": true,
  "addressRules": [
    {
      "ruleName": "UI Elements by Filename",
      "description": "UI sprites and elements use filename as address",
      "enabled": true,
      "priority": 120,
      "skipExisting": false,
      "targetGroupName": "UI",
      "filters": [
        {
          "filterType": "ExtensionFilter",
          "filterAssetPath": "",
          "filterJson": "{\"_enabled\":true,\"_invert\":false,\"_description\":\"Texture assets\",\"_extensions\":\".png,.jpg,.jpeg,.tga,.psd\",\"_matchAny\":true}"
        }
      ],
      "addressProviderType": "FileNameAddressProvider",
      "addressProviderPath": ""
    },
    {
      "ruleName": "Prefabs by Full Path",
      "description": "Prefabs use full path as address for uniqueness",
      "enabled": true,
      "priority": 110,
      "skipExisting": false,
      "targetGroupName": "Prefabs",
      "filters": [
        {
          "filterType": "ExtensionFilter",
          "filterAssetPath": "",
          "filterJson": "{\"_enabled\":true,\"_invert\":false,\"_description\":\"Prefab assets\",\"_extensions\":\".prefab\",\"_matchAny\":true}"
        }
      ],
      "addressProviderType": "PathAddressProvider",
      "addressProviderPath": ""
    },
    {
      "ruleName": "Character Models",
      "description": "Character models and animations",
      "enabled": true,
      "priority": 100,
      "skipExisting": false,
      "targetGroupName": "Characters",
      "filters": [
        {
          "filterType": "ExtensionFilter",
          "filterAssetPath": "",
          "filterJson": "{\"_enabled\":true,\"_invert\":false,\"_description\":\"Animation assets\",\"_extensions\":\".anim,.controller\",\"_matchAny\":true}"
        }
      ],
      "addressProviderType": "PathAddressProvider",
      "addressProviderPath": ""
    },
    {
      "ruleName": "Audio Clips",
      "description": "Music and sound effects",
      "enabled": true,
      "priority": 90,
      "skipExisting": false,
      "targetGroupName": "Audio",
      "filters": [
        {
          "filterType": "ExtensionFilter",
          "filterAssetPath": "",
          "filterJson": "{\"_enabled\":true,\"_invert\":false,\"_description\":\"Audio assets\",\"_extensions\":\".wav,.mp3,.ogg\",\"_matchAny\":true}"
        }
      ],
      "addressProviderType": "FileNameAddressProvider",
      "addressProviderPath": ""
    },
    {
      "ruleName": "Localization Assets",
      "description": "Localized content for different languages",
      "enabled": true,
      "priority": 80,
      "skipExisting": false,
      "targetGroupName": "Localization",
      "filters": [
        {
          "filterType": "PathFilter",
          "filterAssetPath": "",
          "filterJson": "{\"_enabled\":true,\"_invert\":false,\"_description\":\"Everything under Assets - narrow this before enabling\",\"_pattern\":\"Assets/**\",\"_matchMode\":5,\"_caseSensitive\":false}"
        }
      ],
      "addressProviderType": "PathAddressProvider",
      "addressProviderPath": ""
    }
  ],
  "labelRules": [
    {
      "ruleName": "Default Label - Always Load",
      "description": "Assets that should always be loaded",
      "enabled": true,
      "priority": 150,
      "appendToExisting": true,
      "filters": [
        {
          "filterType": "PathFilter",
          "filterAssetPath": "",
          "filterJson": "{\"_enabled\":true,\"_invert\":false,\"_description\":\"Everything under Assets - narrow this before enabling\",\"_pattern\":\"Assets/**\",\"_matchMode\":5,\"_caseSensitive\":false}"
        }
      ],
      "labelProviderType": "ConstantLabelProvider",
      "labelProviderPath": "",
      "labelProviderJson": "{\"_description\":\"Assets that should always be loaded\",\"_labels\":[\"always_load\"]}"
    },
    {
      "ruleName": "Level Content",
      "description": "Per-level assets for streaming",
      "enabled": true,
      "priority": 140,
      "appendToExisting": true,
      "filters": [
        {
          "filterType": "PathFilter",
          "filterAssetPath": "",
          "filterJson": "{\"_enabled\":true,\"_invert\":false,\"_description\":\"Anything under Assets/Levels\",\"_pattern\":\"Assets/Levels/**\",\"_matchMode\":5,\"_caseSensitive\":false}"
        }
      ],
      "labelProviderType": "ConstantLabelProvider",
      "labelProviderPath": "",
      "labelProviderJson": "{\"_description\":\"Per-level assets for streaming\",\"_labels\":[\"level_content\"]}"
    },
    {
      "ruleName": "Platform - PC",
      "description": "PC-specific high quality assets",
      "enabled": true,
      "priority": 130,
      "appendToExisting": true,
      "filters": [
        {
          "filterType": "PathFilter",
          "filterAssetPath": "",
          "filterJson": "{\"_enabled\":true,\"_invert\":false,\"_description\":\"Anything under a HighQuality folder\",\"_pattern\":\"Assets/**/HighQuality/**\",\"_matchMode\":5,\"_caseSensitive\":false}"
        }
      ],
      "labelProviderType": "ConstantLabelProvider",
      "labelProviderPath": "",
      "labelProviderJson": "{\"_description\":\"PC-specific high quality assets\",\"_labels\":[\"platform_pc\"]}"
    },
    {
      "ruleName": "Platform - Mobile",
      "description": "Mobile-optimized assets",
      "enabled": true,
      "priority": 120,
      "appendToExisting": true,
      "filters": [
        {
          "filterType": "PathFilter",
          "filterAssetPath": "",
          "filterJson": "{\"_enabled\":true,\"_invert\":false,\"_description\":\"Anything under a Mobile folder\",\"_pattern\":\"Assets/**/Mobile/**\",\"_matchMode\":5,\"_caseSensitive\":false}"
        }
      ],
      "labelProviderType": "ConstantLabelProvider",
      "labelProviderPath": "",
      "labelProviderJson": "{\"_description\":\"Mobile-optimized assets\",\"_labels\":[\"platform_mobile\"]}"
    },
    {
      "ruleName": "DLC Content",
      "description": "Downloadable content marker",
      "enabled": true,
      "priority": 110,
      "appendToExisting": true,
      "filters": [
        {
          "filterType": "PathFilter",
          "filterAssetPath": "",
          "filterJson": "{\"_enabled\":true,\"_invert\":false,\"_description\":\"Anything under Assets/DLC\",\"_pattern\":\"Assets/DLC/**\",\"_matchMode\":5,\"_caseSensitive\":false}"
        }
      ],
      "labelProviderType": "ConstantLabelProvider",
      "labelProviderPath": "",
      "labelProviderJson": "{\"_description\":\"Downloadable content marker\",\"_labels\":[\"content_dlc\"]}"
    },
    {
      "ruleName": "Language - English",
      "description": "English localization",
      "enabled": true,
      "priority": 100,
      "appendToExisting": true,
      "filters": [
        {
          "filterType": "PathFilter",
          "filterAssetPath": "",
          "filterJson": "{\"_enabled\":true,\"_invert\":false,\"_description\":\"Everything under Assets - narrow this before enabling\",\"_pattern\":\"Assets/**\",\"_matchMode\":5,\"_caseSensitive\":false}"
        }
      ],
      "labelProviderType": "ConstantLabelProvider",
      "labelProviderPath": "",
      "labelProviderJson": "{\"_description\":\"English localization\",\"_labels\":[\"lang_en\"]}"
    },
    {
      "ruleName": "Language - Spanish",
      "description": "Spanish localization",
      "enabled": true,
      "priority": 90,
      "appendToExisting": true,
      "filters": [
        {
          "filterType": "PathFilter",
          "filterAssetPath": "",
          "filterJson": "{\"_enabled\":true,\"_invert\":false,\"_description\":\"Everything under Assets - narrow this before enabling\",\"_pattern\":\"Assets/**\",\"_matchMode\":5,\"_caseSensitive\":false}"
        }
      ],
      "labelProviderType": "ConstantLabelProvider",
      "labelProviderPath": "",
      "labelProviderJson": "{\"_description\":\"Spanish localization\",\"_labels\":[\"lang_es\"]}"
    },
    {
      "ruleName": "Language - Japanese",
      "description": "Japanese localization",
      "enabled": true,
      "priority": 80,
      "appendToExisting": true,
      "filters": [
        {
          "filterType": "PathFilter",
          "filterAssetPath": "",
          "filterJson": "{\"_enabled\":true,\"_invert\":false,\"_description\":\"Everything under Assets - narrow this before enabling\",\"_pattern\":\"Assets/**\",\"_matchMode\":5,\"_caseSensitive\":false}"
        }
      ],
      "labelProviderType": "ConstantLabelProvider",
      "labelProviderPath": "",
      "labelProviderJson": "{\"_description\":\"Japanese localization\",\"_labels\":[\"lang_ja\"]}"
    }
  ],
  "versionRules": [
    {
      "ruleName": "Build Number Version",
      "description": "Use Unity build version for all assets",
      "enabled": true,
      "priority": 100,
      "skipExisting": false,
      "filters": [
        {
          "filterType": "PathFilter",
          "filterAssetPath": "",
          "filterJson": "{\"_enabled\":true,\"_invert\":false,\"_description\":\"Anything under Assets/UI\",\"_pattern\":\"Assets/UI/**\",\"_matchMode\":5,\"_caseSensitive\":false}"
        }
      ],
      "versionProviderType": "BuildNumberVersionProvider",
      "versionProviderPath": ""
    },
    {
      "ruleName": "Git Commit Hash",
      "description": "Track assets by git commit (useful for dev builds)",
      "enabled": false,
      "priority": 90,
      "skipExisting": false,
      "filters": [
        {
          "filterType": "PathFilter",
          "filterAssetPath": "",
          "filterJson": "{\"_enabled\":true,\"_invert\":false,\"_description\":\"Anything under Assets/UI\",\"_pattern\":\"Assets/UI/**\",\"_matchMode\":5,\"_caseSensitive\":false}"
        }
      ],
      "versionProviderType": "GitCommitVersionProvider",
      "versionProviderPath": ""
    },
    {
      "ruleName": "Date Timestamp",
      "description": "Version by build timestamp",
      "enabled": false,
      "priority": 80,
      "skipExisting": false,
      "filters": [
        {
          "filterType": "PathFilter",
          "filterAssetPath": "",
          "filterJson": "{\"_enabled\":true,\"_invert\":false,\"_description\":\"Anything under Assets/UI\",\"_pattern\":\"Assets/UI/**\",\"_matchMode\":5,\"_caseSensitive\":false}"
        }
      ],
      "versionProviderType": "DateVersionProvider",
      "versionProviderPath": ""
    }
  ]
}
