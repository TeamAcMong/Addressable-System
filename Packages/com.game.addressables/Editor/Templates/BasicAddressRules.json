{
  "version": "1.0",
  "description": "Basic address assignment rules - Assigns addresses based on asset paths",
  "autoApplyOnImport": false,
  "autoApplyOnModified": false,
  "verboseLogging": false,
  "versionExpression": "",
  "excludeUnversioned": false,
  "addressRules": [
    {
      "ruleName": "UI Sprites by Filename",
      "description": "Assign UI sprites using their filename as address",
      "enabled": true,
      "priority": 100,
      "skipExisting": false,
      "targetGroupName": "UI",
      "filters": [
        {
          "filterType": "PathFilter",
          "filterAssetPath": "Packages/com.game.addressables/Editor/Templates/BasicAddressRules/UISpritesPathFilter.asset"
        }
      ],
      "addressProviderType": "FileNameAddressProvider",
      "addressProviderPath": "Packages/com.game.addressables/Editor/Templates/BasicAddressRules/FileNameAddressProvider.asset"
    },
    {
      "ruleName": "Prefabs by Path",
      "description": "Assign prefabs using their full path as address",
      "enabled": true,
      "priority": 90,
      "skipExisting": false,
      "targetGroupName": "Prefabs",
      "filters": [
        {
          "filterType": "PathFilter",
          "filterAssetPath": "Packages/com.game.addressables/Editor/Templates/BasicAddressRules/PrefabsPathFilter.asset"
        }
      ],
      "addressProviderType": "PathAddressProvider",
      "addressProviderPath": "Packages/com.game.addressables/Editor/Templates/BasicAddressRules/PathAddressProvider.asset"
    },
    {
      "ruleName": "Audio by Filename",
      "description": "Assign audio clips using their filename",
      "enabled": true,
      "priority": 80,
      "skipExisting": false,
      "targetGroupName": "Audio",
      "filters": [
        {
          "filterType": "PathFilter",
          "filterAssetPath": "Packages/com.game.addressables/Editor/Templates/BasicAddressRules/AudioPathFilter.asset"
        }
      ],
      "addressProviderType": "FileNameAddressProvider",
      "addressProviderPath": "Packages/com.game.addressables/Editor/Templates/BasicAddressRules/FileNameAddressProvider.asset"
    }
  ],
  "labelRules": [],
  "versionRules": []
}
