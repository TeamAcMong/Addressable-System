{
  "version": "1.0",
  "description": "Material and Texture rules - Organize materials and textures by type and quality",
  "autoApplyOnImport": false,
  "autoApplyOnModified": false,
  "verboseLogging": false,
  "versionExpression": "",
  "excludeUnversioned": false,
  "addressRules": [
    {
      "ruleName": "Character Materials",
      "description": "Materials for character models",
      "enabled": true,
      "priority": 110,
      "skipExisting": false,
      "targetGroupName": "Materials",
      "filters": [
        {
          "filterType": "ExtensionFilter",
          "filterAssetPath": "",
          "filterJson": "{\"_enabled\":true,\"_invert\":false,\"_description\":\"Material assets\",\"_extensions\":\".mat\",\"_matchAny\":true}"
        }
      ],
      "addressProviderType": "PathAddressProvider",
      "addressProviderPath": ""
    },
    {
      "ruleName": "Environment Materials",
      "description": "Materials for environment objects",
      "enabled": true,
      "priority": 100,
      "skipExisting": false,
      "targetGroupName": "Materials",
      "filters": [
        {
          "filterType": "ExtensionFilter",
          "filterAssetPath": "",
          "filterJson": "{\"_enabled\":true,\"_invert\":false,\"_description\":\"Material assets\",\"_extensions\":\".mat\",\"_matchAny\":true}"
        }
      ],
      "addressProviderType": "PathAddressProvider",
      "addressProviderPath": ""
    },
    {
      "ruleName": "High Res Textures",
      "description": "4K and 2K textures",
      "enabled": true,
      "priority": 90,
      "skipExisting": false,
      "targetGroupName": "Textures_High",
      "filters": [
        {
          "filterType": "ExtensionFilter",
          "filterAssetPath": "",
          "filterJson": "{\"_enabled\":true,\"_invert\":false,\"_description\":\"Texture assets\",\"_extensions\":\".png,.jpg,.jpeg,.tga,.psd\",\"_matchAny\":true}"
        }
      ],
      "addressProviderType": "PathAddressProvider",
      "addressProviderPath": ""
    },
    {
      "ruleName": "Normal Res Textures",
      "description": "1K textures",
      "enabled": true,
      "priority": 80,
      "skipExisting": false,
      "targetGroupName": "Textures_Normal",
      "filters": [
        {
          "filterType": "ExtensionFilter",
          "filterAssetPath": "",
          "filterJson": "{\"_enabled\":true,\"_invert\":false,\"_description\":\"Texture assets\",\"_extensions\":\".png,.jpg,.jpeg,.tga,.psd\",\"_matchAny\":true}"
        }
      ],
      "addressProviderType": "PathAddressProvider",
      "addressProviderPath": ""
    },
    {
      "ruleName": "Low Res Textures",
      "description": "512px and below",
      "enabled": true,
      "priority": 70,
      "skipExisting": false,
      "targetGroupName": "Textures_Low",
      "filters": [
        {
          "filterType": "ExtensionFilter",
          "filterAssetPath": "",
          "filterJson": "{\"_enabled\":true,\"_invert\":false,\"_description\":\"Texture assets\",\"_extensions\":\".png,.jpg,.jpeg,.tga,.psd\",\"_matchAny\":true}"
        }
      ],
      "addressProviderType": "PathAddressProvider",
      "addressProviderPath": ""
    }
  ],
  "labelRules": [
    {
      "ruleName": "PBR Material Label",
      "description": "Label PBR materials",
      "enabled": true,
      "priority": 100,
      "appendToExisting": true,
      "filters": [
        {
          "filterType": "ExtensionFilter",
          "filterAssetPath": "",
          "filterJson": "{\"_enabled\":true,\"_invert\":false,\"_description\":\"Material assets\",\"_extensions\":\".mat\",\"_matchAny\":true}"
        }
      ],
      "labelProviderType": "ConstantLabelProvider",
      "labelProviderPath": "",
      "labelProviderJson": "{\"_description\":\"Label PBR materials\",\"_labels\":[\"material_pbr\"]}"
    },
    {
      "ruleName": "Diffuse Texture Label",
      "description": "Label diffuse/albedo textures",
      "enabled": true,
      "priority": 90,
      "appendToExisting": true,
      "filters": [
        {
          "filterType": "ExtensionFilter",
          "filterAssetPath": "",
          "filterJson": "{\"_enabled\":true,\"_invert\":false,\"_description\":\"Texture assets\",\"_extensions\":\".png,.jpg,.jpeg,.tga,.psd\",\"_matchAny\":true}"
        }
      ],
      "labelProviderType": "ConstantLabelProvider",
      "labelProviderPath": "",
      "labelProviderJson": "{\"_description\":\"Label diffuse/albedo textures\",\"_labels\":[\"texture_diffuse\"]}"
    },
    {
      "ruleName": "Normal Map Label",
      "description": "Label normal maps",
      "enabled": true,
      "priority": 80,
      "appendToExisting": true,
      "filters": [
        {
          "filterType": "PathFilter",
          "filterAssetPath": "",
          "filterJson": "{\"_enabled\":true,\"_invert\":false,\"_description\":\"Anything under Assets/Levels\",\"_pattern\":\"Assets/Levels/**\",\"_matchMode\":5,\"_caseSensitive\":false}"
        }
      ],
      "labelProviderType": "ConstantLabelProvider",
      "labelProviderPath": "",
      "labelProviderJson": "{\"_description\":\"Label normal maps\",\"_labels\":[\"texture_normal\"]}"
    },
    {
      "ruleName": "Quality Level - High",
      "description": "High quality assets",
      "enabled": true,
      "priority": 70,
      "appendToExisting": true,
      "filters": [
        {
          "filterType": "PathFilter",
          "filterAssetPath": "",
          "filterJson": "{\"_enabled\":true,\"_invert\":false,\"_description\":\"Anything under a HighQuality folder\",\"_pattern\":\"Assets/**/HighQuality/**\",\"_matchMode\":5,\"_caseSensitive\":false}"
        }
      ],
      "labelProviderType": "ConstantLabelProvider",
      "labelProviderPath": "",
      "labelProviderJson": "{\"_description\":\"High quality assets\",\"_labels\":[\"quality_high\"]}"
    },
    {
      "ruleName": "Quality Level - Medium",
      "description": "Medium quality assets",
      "enabled": true,
      "priority": 60,
      "appendToExisting": true,
      "filters": [
        {
          "filterType": "PathFilter",
          "filterAssetPath": "",
          "filterJson": "{\"_enabled\":true,\"_invert\":false,\"_description\":\"Anything under Assets/Levels\",\"_pattern\":\"Assets/Levels/**\",\"_matchMode\":5,\"_caseSensitive\":false}"
        }
      ],
      "labelProviderType": "ConstantLabelProvider",
      "labelProviderPath": "",
      "labelProviderJson": "{\"_description\":\"Medium quality assets\",\"_labels\":[\"quality_medium\"]}"
    },
    {
      "ruleName": "Quality Level - Low",
      "description": "Low quality assets",
      "enabled": true,
      "priority": 50,
      "appendToExisting": true,
      "filters": [
        {
          "filterType": "PathFilter",
          "filterAssetPath": "",
          "filterJson": "{\"_enabled\":true,\"_invert\":false,\"_description\":\"Anything under Assets/Levels\",\"_pattern\":\"Assets/Levels/**\",\"_matchMode\":5,\"_caseSensitive\":false}"
        }
      ],
      "labelProviderType": "ConstantLabelProvider",
      "labelProviderPath": "",
      "labelProviderJson": "{\"_description\":\"Low quality assets\",\"_labels\":[\"quality_low\"]}"
    }
  ],
  "versionRules": []
}
