/*
 * Shell chrome for AddressableManagerHub.
 *
 * Layout and spacing only - every colour comes from --unity-colors-* so the window follows the
 * active Editor skin (design doc §5.11). USS has no CSS grid, no ::before/::after, no box-shadow,
 * no rem/em and no @media; nothing here needs them.
 *
 * The four state modifiers at the bottom are the load-bearing part of this sheet. They are the
 * only place a health state becomes a colour, so "not measured" cannot accidentally be painted
 * the same as "passed" by one screen that forgot - see SectionHealth.
 */

.hub-root {
    flex-grow: 1;
    background-color: var(--unity-colors-window-background);
}

/* ---------- header ---------- */

.hub-header {
    flex-direction: row;
    align-items: center;
    height: 26px;
    padding: 0 8px;
    flex-shrink: 0;
    background-color: var(--unity-colors-toolbar-background);
    border-bottom-width: 1px;
    border-bottom-color: var(--unity-colors-window-border);
}

.hub-header-title {
    font-size: 12px;
    -unity-font-style: bold;
    color: var(--unity-colors-default-text);
}

.hub-header-spacer {
    flex-grow: 1;
}

.hub-header-context {
    font-size: 11px;
    color: var(--unity-colors-default-text);
    opacity: 0.7;
}

/* ---------- body split ---------- */

.hub-body {
    flex-direction: row;
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
}

/* ---------- rail ---------- */

.hub-rail {
    width: 196px;
    flex-shrink: 0;
    flex-direction: column;
    background-color: var(--unity-colors-default-background);
    border-right-width: 1px;
    border-right-color: var(--unity-colors-window-border);
}

.hub-rail-caption {
    font-size: 9px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    padding: 9px 10px 3px 10px;
    color: var(--unity-colors-default-text);
    opacity: 0.5;
}

.hub-rail-scroll {
    flex-grow: 1;
}

.hub-rail-stages {
    flex-direction: column;
}

/* a stage heading: dot, label, badge */
.hub-stage {
    flex-direction: row;
    align-items: center;
    padding: 4px 10px 2px 10px;
    flex-shrink: 0;
}

.hub-stage-dot {
    width: 8px;
    height: 8px;
    border-radius: 4px;
    flex-shrink: 0;
    margin-right: 7px;
    border-width: 2px;
}

.hub-stage-label {
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    flex-grow: 1;
    color: var(--unity-colors-default-text);
    opacity: 0.8;
}

.hub-stage-badge {
    font-size: 9px;
    -unity-font-style: bold;
    flex-shrink: 0;
}

/* a section row under a stage */
.hub-section-row {
    flex-direction: row;
    align-items: center;
    padding: 3px 10px 3px 25px;
    flex-shrink: 0;
}

.hub-section-row:hover {
    background-color: var(--unity-colors-highlight-background-hover);
}

.hub-section-row--active {
    background-color: var(--unity-colors-highlight-background);
}

.hub-section-row-label {
    font-size: 11px;
    flex-grow: 1;
    color: var(--unity-colors-default-text);
}

.hub-section-row--active .hub-section-row-label {
    -unity-font-style: bold;
}

.hub-section-row-dot {
    width: 5px;
    height: 5px;
    border-radius: 3px;
    flex-shrink: 0;
    margin-left: 4px;
}

/* the "pipeline stops here" note pinned to the bottom of the rail */
.hub-rail-blocker {
    flex-shrink: 0;
    flex-direction: column;
    margin: 6px;
    padding: 6px 8px;
    border-width: 1px;
    border-radius: 3px;
    border-color: var(--unity-colors-window-border);
    background-color: var(--unity-colors-toolbar-background);
}

.hub-rail-blocker-title {
    font-size: 10px;
    -unity-font-style: bold;
    white-space: normal;
}

.hub-rail-blocker-body {
    font-size: 10px;
    margin-top: 2px;
    white-space: normal;
    color: var(--unity-colors-default-text);
    opacity: 0.75;
}

/* ---------- content ---------- */

.hub-content {
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: column;
    min-width: 0;
}

.hub-section-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    flex-shrink: 0;
    height: 36px;
    padding: 0 10px;
    background-color: var(--unity-colors-toolbar-background);
    border-bottom-width: 1px;
    border-bottom-color: var(--unity-colors-window-border);
}

.hub-section-titles {
    flex-direction: column;
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.hub-section-title {
    font-size: 12px;
    -unity-font-style: bold;
    color: var(--unity-colors-default-text);
}

.hub-section-subtitle {
    font-size: 10px;
    color: var(--unity-colors-default-text);
    opacity: 0.65;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.hub-section-actions {
    flex-direction: row;
    flex-shrink: 0;
}

.hub-section-body {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
}

/* ---------- status bar ---------- */

.hub-status {
    flex-direction: row;
    align-items: center;
    height: 20px;
    padding: 0 8px;
    flex-shrink: 0;
    background-color: var(--unity-colors-toolbar-background);
    border-top-width: 1px;
    border-top-color: var(--unity-colors-window-border);
}

.hub-status-dot {
    width: 6px;
    height: 6px;
    border-radius: 3px;
    flex-shrink: 0;
    margin-right: 7px;
}

.hub-status-text {
    font-size: 10px;
    flex-grow: 1;
    color: var(--unity-colors-default-text);
    opacity: 0.8;
}

.hub-status-context {
    font-size: 10px;
    flex-shrink: 0;
    color: var(--unity-colors-default-text);
    opacity: 0.55;
}

/*
 * ---------- the four states ----------
 *
 * Applied to dots, badges and text. Four, not three: "unmeasured" is hollow rather than filled,
 * so a check that did not run can never be mistaken for one that passed - which is exactly what
 * happened when the two shared a colour.
 */

.hub-state--ok {
    background-color: var(--unity-colors-default-text);
    border-color: var(--unity-colors-default-text);
    color: var(--unity-colors-default-text);
    opacity: 0.55;
}

.hub-state--warn {
    background-color: var(--unity-colors-warning-text);
    border-color: var(--unity-colors-warning-text);
    color: var(--unity-colors-warning-text);
}

.hub-state--blocked {
    background-color: var(--unity-colors-error-text);
    border-color: var(--unity-colors-error-text);
    color: var(--unity-colors-error-text);
}

/* hollow: a ring with the window behind it, never a filled dot */
.hub-state--unmeasured {
    background-color: rgba(0, 0, 0, 0);
    border-color: var(--unity-colors-default-text);
    color: var(--unity-colors-default-text);
    opacity: 0.4;
}

/*
 * ---------- shared section vocabulary ----------
 *
 * The shell's stylesheet is added to the window root, so every section rendered under
 * hub-section-body inherits these. That is deliberate: the design's whole argument is that the
 * screens should share one vocabulary rather than each inventing its own spacing and its own way
 * of saying "this is wrong". A section that needs something different declares it locally.
 */

.hub-page {
    flex-grow: 1;
    padding: 10px;
}

.hub-card {
    flex-shrink: 0;
    margin-bottom: 8px;
    border-width: 1px;
    border-radius: 3px;
    border-color: var(--unity-colors-window-border);
}

.hub-card-header {
    flex-direction: row;
    align-items: center;
    padding: 4px 8px;
    background-color: var(--unity-colors-toolbar-background);
    border-bottom-width: 1px;
    border-bottom-color: var(--unity-colors-window-border);
}

.hub-card-title {
    font-size: 11px;
    -unity-font-style: bold;
    flex-grow: 1;
    color: var(--unity-colors-default-text);
}

.hub-card-count {
    font-size: 10px;
    flex-shrink: 0;
    color: var(--unity-colors-default-text);
    opacity: 0.6;
}

/* one contract rule */
.hub-rule {
    flex-direction: row;
    align-items: flex-start;
    padding: 7px 8px;
    border-bottom-width: 1px;
    border-bottom-color: var(--unity-colors-window-border);
}

/*
 * Hover is a PROMISE. It only goes on rows that do something when clicked.
 *
 * Every row in every section used to light up under the cursor, and almost none of them were
 * interactive - the Validator's rules, the rule list, the lifetime inventory, the profile table.
 * A row that highlights and then ignores the click is the same defect as a button whose handler is
 * empty, and this package has shipped that twice already. Adding the modifier is now the deliberate
 * act of saying "this one really is clickable".
 */
.hub-rule--clickable:hover {
    background-color: var(--unity-colors-highlight-background-hover);
}

.hub-rule-dot {
    width: 7px;
    height: 7px;
    border-radius: 4px;
    border-width: 2px;
    flex-shrink: 0;
    margin-top: 4px;
    margin-right: 8px;
}

.hub-rule-text {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    flex-direction: column;
}

.hub-rule-headline {
    font-size: 11px;
    white-space: normal;
    color: var(--unity-colors-default-text);
}

.hub-rule-meta {
    font-size: 10px;
    margin-top: 3px;
    white-space: normal;
    color: var(--unity-colors-default-text);
    opacity: 0.6;
}

.hub-rule-id {
    font-size: 9px;
    margin-top: 4px;
    color: var(--unity-colors-default-text);
    opacity: 0.45;
}

.hub-rule-actions {
    flex-direction: row;
    flex-shrink: 0;
    margin-left: 8px;
}

.hub-btn {
    min-width: 54px;
    margin-left: 4px;
    font-size: 11px;
}

.hub-summary {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    padding: 5px 8px;
    margin-bottom: 8px;
    border-width: 1px;
    border-radius: 3px;
    border-color: var(--unity-colors-window-border);
    background-color: var(--unity-colors-toolbar-background);
}

.hub-summary-item {
    flex-direction: row;
    align-items: center;
    margin-right: 14px;
}

.hub-summary-dot {
    width: 7px;
    height: 7px;
    border-radius: 4px;
    border-width: 2px;
    margin-right: 5px;
}

.hub-summary-label {
    font-size: 11px;
    color: var(--unity-colors-default-text);
}

.hub-note {
    flex-shrink: 0;
    padding: 7px 9px;
    margin-bottom: 8px;
    border-width: 1px;
    border-radius: 3px;
    border-color: var(--unity-colors-window-border);
}

.hub-note-text {
    font-size: 10px;
    white-space: normal;
    color: var(--unity-colors-default-text);
    opacity: 0.75;
}

/*
 * ---------- overview: the horizontal pipeline ----------
 *
 * The link between nodes is the reason this is drawn rather than listed. A run of solid links that
 * goes dead at one node says "it stops here" faster than any sentence can.
 */

.hub-flow {
    flex-direction: row;
    align-items: flex-start;
    padding: 12px 8px 10px 8px;
}

.hub-flow-cell {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    flex-direction: column;
    align-items: center;
}

.hub-flow-noderow {
    flex-direction: row;
    align-items: center;
    width: 100%;
}

.hub-flow-link {
    height: 2px;
    flex-grow: 1;
    background-color: var(--unity-colors-default-text);
    opacity: 0.45;
}

/* everything after the first blocked stage */
.hub-flow-link--dead {
    opacity: 0.12;
}

.hub-flow-node {
    width: 14px;
    height: 14px;
    border-radius: 7px;
    border-width: 2px;
    flex-shrink: 0;
}

.hub-flow-label {
    font-size: 11px;
    -unity-font-style: bold;
    margin-top: 6px;
    color: var(--unity-colors-default-text);
}

.hub-flow-note {
    font-size: 10px;
    margin-top: 1px;
    background-color: rgba(0, 0, 0, 0);
    border-color: rgba(0, 0, 0, 0);
}

/* ---------- overview: stat cards ---------- */

.hub-stats {
    flex-direction: row;
    flex-shrink: 0;
    margin-bottom: 8px;
}

.hub-stat {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    margin-right: 6px;
    padding: 7px 9px;
    border-width: 1px;
    border-radius: 3px;
    border-color: var(--unity-colors-window-border);
    background-color: var(--unity-colors-toolbar-background);
}

.hub-stat-caption {
    font-size: 9px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: var(--unity-colors-default-text);
    opacity: 0.55;
}

.hub-stat-valuerow {
    flex-direction: row;
    align-items: flex-end;
    margin-top: 2px;
}

.hub-stat-value {
    font-size: 18px;
    -unity-font-style: bold;
    background-color: rgba(0, 0, 0, 0);
    border-color: rgba(0, 0, 0, 0);
}

.hub-stat-unit {
    font-size: 10px;
    margin-left: 4px;
    margin-bottom: 3px;
    color: var(--unity-colors-default-text);
    opacity: 0.6;
}

.hub-stat-foot {
    font-size: 9px;
    margin-top: 2px;
    white-space: normal;
    color: var(--unity-colors-default-text);
    opacity: 0.5;
}

/* ---------- overview: what needs you ---------- */

.hub-todo-bar {
    width: 3px;
    flex-shrink: 0;
    margin-right: 8px;
    border-radius: 2px;
    border-width: 0;
}

.hub-todo-blocks {
    width: 110px;
    flex-shrink: 0;
    font-size: 10px;
    -unity-text-align: middle-right;
    color: var(--unity-colors-default-text);
    opacity: 0.55;
}

/* ---------- rail connector ---------- */

.hub-gutter {
    width: 14px;
    flex-shrink: 0;
    flex-direction: column;
    align-items: center;
    align-self: stretch;
    margin-right: 7px;
}

.hub-gutter-line {
    width: 2px;
    flex-grow: 1;
    min-height: 3px;
    background-color: var(--unity-colors-default-text);
    opacity: 0.35;
}

/* everything below the first blocked stage: content does not get here */
.hub-gutter-line--dead {
    opacity: 0.1;
}

/* ---------- profiles: conformance table ---------- */

.hub-prow {
    flex-direction: row;
    align-items: center;
    padding: 5px 8px;
    border-bottom-width: 1px;
    border-bottom-color: var(--unity-colors-window-border);
}

.hub-prow--clickable:hover {
    background-color: var(--unity-colors-highlight-background-hover);
}

/*
 * Two different ideas, drawn differently on purpose.
 *
 *   --selected  where the cursor is on this screen. Highlight, like any list.
 *   --active    the profile Addressables will actually BUILD with. A left accent bar, because it
 *               stays true whether or not this screen has focus, and confusing the two is how a
 *               build goes out against the profile someone merely clicked on.
 */
.hub-prow--selected {
    background-color: var(--unity-colors-highlight-background);
}

.hub-prow--active {
    border-left-width: 3px;
    border-left-color: var(--unity-colors-default-text);
}

.hub-pcol {
    font-size: 10px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--unity-colors-default-text);
    background-color: rgba(0, 0, 0, 0);
    border-color: rgba(0, 0, 0, 0);
}

.hub-pcol-head {
    font-size: 9px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: var(--unity-colors-default-text);
    opacity: 0.55;
}

.hub-col-profile {
    width: 116px;
    flex-shrink: 0;
    font-size: 11px;
}

.hub-col-origin {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.hub-col-suffix {
    width: 78px;
    flex-shrink: 0;
}

.hub-col-known {
    width: 104px;
    flex-shrink: 0;
}

/* ---------- Ctrl+K palette ---------- */

.hub-palette {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    background-color: rgba(0, 0, 0, 0.45);
}

.hub-palette-panel {
    width: 420px;
    max-width: 92%;
    margin-top: 60px;
    padding: 8px;
    border-width: 1px;
    border-radius: 4px;
    border-color: var(--unity-colors-window-border);
    background-color: var(--unity-colors-window-background);
}

.hub-palette-query {
    margin-bottom: 6px;
}

.hub-palette-results {
    flex-direction: column;
    max-height: 260px;
}

.hub-palette-row {
    flex-direction: row;
    align-items: center;
    padding: 4px 7px;
    border-radius: 3px;
}

.hub-palette-row:hover {
    background-color: var(--unity-colors-highlight-background-hover);
}

.hub-palette-row--on {
    background-color: var(--unity-colors-highlight-background);
}

.hub-palette-title {
    font-size: 11px;
    flex-grow: 1;
    color: var(--unity-colors-default-text);
}

.hub-palette-stage {
    font-size: 9px;
    flex-shrink: 0;
    color: var(--unity-colors-default-text);
    opacity: 0.5;
}

.hub-palette-none {
    font-size: 11px;
    padding: 8px 7px;
    color: var(--unity-colors-default-text);
    opacity: 0.6;
}

.hub-palette-hint {
    font-size: 9px;
    margin-top: 6px;
    -unity-text-align: middle-center;
    color: var(--unity-colors-default-text);
    opacity: 0.45;
}

/* ---------- header chips ---------- */

.hub-header-chips {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

.hub-chip {
    flex-direction: row;
    align-items: center;
    margin-left: 6px;
    padding: 1px 6px;
    border-width: 1px;
    border-radius: 3px;
    border-color: var(--unity-colors-window-border);
    background-color: var(--unity-colors-default-background);
}

.hub-chip--clickable:hover {
    background-color: var(--unity-colors-highlight-background-hover);
}

.hub-chip-key {
    font-size: 9px;
    margin-right: 5px;
    color: var(--unity-colors-default-text);
    opacity: 0.55;
}

.hub-chip-value {
    font-size: 11px;
    color: var(--unity-colors-default-text);
}

/* ---------- build: what ships where ---------- */

.hub-splitbar {
    flex-direction: row;
    height: 18px;
    margin: 7px 8px 4px 8px;
    border-width: 1px;
    border-radius: 3px;
    border-color: var(--unity-colors-window-border);
    overflow: hidden;
}

.hub-splitbar-remote {
    background-color: var(--unity-colors-highlight-background);
}

.hub-splitbar-local {
    background-color: var(--unity-colors-default-text);
    opacity: 0.45;
}

.hub-splitbar-none {
    background-color: var(--unity-colors-warning-text);
}

.hub-splitlegend {
    flex-direction: row;
    align-items: center;
    padding: 0 8px 6px 8px;
}

.hub-splitlegend-item {
    flex-direction: row;
    align-items: center;
    margin-right: 14px;
}

.hub-splitlegend-swatch {
    width: 9px;
    height: 9px;
    border-radius: 2px;
    margin-right: 5px;
}

.hub-splitlegend-label {
    font-size: 10px;
    color: var(--unity-colors-default-text);
    opacity: 0.75;
}

/* ---------- first run ---------- */

.hub-step-marker {
    width: 18px;
    height: 18px;
    border-radius: 9px;
    border-width: 2px;
    flex-shrink: 0;
    margin-right: 9px;
    align-items: center;
    justify-content: center;
}

.hub-step-number {
    font-size: 9px;
    -unity-font-style: bold;
    color: var(--unity-colors-window-background);
}

/* ---------- two-pane split ---------- */

.hub-split {
    flex-direction: row;
    align-items: flex-start;
}

.hub-split-left {
    width: 280px;
    flex-shrink: 0;
    margin-right: 8px;
}

.hub-split-right {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}
